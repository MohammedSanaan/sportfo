# Copy to .env for local development. Never commit .env.
PORT=8080

# Shared secret the Supabase Edge Function (send-auth-sms) must send as
# `Authorization: Bearer <value>`. Generate a long random value, e.g.
# `openssl rand -base64 32`. Also set as SMS_GATEWAY_SHARED_SECRET on the
# Edge Function -- both sides must hold the exact same value.
SMS_GATEWAY_SHARED_SECRET=

# MSG91 credentials -- from the MSG91 dashboard. Never commit real values.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SPORTFO
