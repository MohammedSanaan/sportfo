# Supabase project connection.
# These are safe to expose to the browser (NEXT_PUBLIC_*) -- they identify
# the project and are paired with Row Level Security, not a secret.
# Never add a service-role key here or anywhere prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Copy this file to .env.local and fill in real values for local development:
#   cp .env.example .env.local
# .env.local is git-ignored and must never be committed.
