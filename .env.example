# Supabase project connection.
# These are safe to expose to the browser (NEXT_PUBLIC_*) -- they identify
# the project and are paired with Row Level Security, not a secret.
# Never add a service-role key here or anywhere prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Copy this file to .env.local and fill in real values for local development:
#   cp .env.example .env.local
# .env.local is git-ignored and must never be committed.

# Temporary MVP switch for the authentication strategy. "demo" uses
# Supabase anonymous auth with a self-reported, unverified mobile number
# (fast to test, no SMS provider needed). "otp" is the real, production
# phone-verified flow. Any value other than exactly "demo" falls back to
# "otp", so leaving this unset is always safe for production.
#
# Left commented out on purpose: uncomment for local/demo testing only.
# Production environment variables must NOT set this to "demo", or every
# login skips real phone verification.
# NEXT_PUBLIC_AUTH_MODE=demo

# Development/demo-only visual filler for the Athlete Dashboard (/dashboard).
# When exactly "true", sections with no real backend yet (opportunities, top
# coaches, recommended academies, sponsorship/trial/invite metrics, platform
# stats) render fixed, clearly-labelled sample content instead of their
# honest empty state -- purely for showing the finished layout in local/demo
# environments. Real user identity, SportFo ID, and profile strength are
# NEVER replaced by demo data, and no demo record is ever written to
# Supabase. Left commented out on purpose: production must NOT set this to
# "true", or real users see fabricated sponsorships/coaches/academies.
# NEXT_PUBLIC_DASHBOARD_DEMO_DATA=true

# SportFo Assistant (server-side AI backend -- see
# src/features/ai-assistant/server). These are SERVER ONLY: never prefix
# any of them NEXT_PUBLIC_, never reference them from a Client Component,
# and never commit a real key here or anywhere else. The browser/mobile
# app calls POST /api/assistant only -- it never talks to OpenAI directly
# and never sees these values.
#
# Which AI provider the assistant uses. Only "openai" is implemented today;
# unset falls back to "openai".
AI_PROVIDER=openai
# Your OpenAI secret API key. Required for the assistant to actually work;
# if unset, /api/assistant clearly reports the provider as unconfigured
# instead of the app failing to build or start.
OPENAI_API_KEY=
# The OpenAI model the assistant calls, e.g. gpt-4.1-mini. If unset, a
# centrally documented development default is used (see
# src/features/ai-assistant/server/providers/model-config.ts) -- production
# should always set this explicitly.
OPENAI_MODEL=